{
  "Authentication": {
    "Issuer": "specproof-platform",
    "Audience": "specproof-clients"
  },
  "Security": {
    "RequireHttps": true,
    "DeviceCertificates": {
      "RequireChainTrust": true,
      "RequireClientAuthenticationEku": true,
      "RevocationMode": "Online",
      "AllowedRootCertificateSha256": []
    }
  }
}
